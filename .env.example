DISCORD_TOKEN=YOUR_TOKEN_HERE

# Role required to run !purge / !purge confirm.
# Prefer a numeric role ID (right-click the role in Discord -> copy).
# If PURGE_ROLE_ID is unset or not found, PURGE_ROLE_NAME is matched
# case-insensitively in the guild.
PURGE_ROLE_ID=
PURGE_ROLE_NAME=

# Logging. Every log line (console + file) uses LOG_LEVEL as the minimum
# severity: debug | info | warn | error
LOG_LEVEL=info
# File log location, appended (create the folder: run from the project root).
LOG_FILE=logs/kevbot.log
