DISCORD_TOKEN=YOUR_TOKEN_HERE

# Role required to run /purge (dry-run and preview).
# Prefer a numeric role ID (right-click the role in Discord -> copy).
# If PURGE_ROLE_ID is unset or not found, PURGE_ROLE_NAME is matched
# case-insensitively in the guild.
PURGE_ROLE_ID=
PURGE_ROLE_NAME=

# Logging. Every log line (console + file) uses LOG_LEVEL as the minimum
# severity: debug | info | warn | error
LOG_LEVEL=info
# Serialization of the LOG FILE only (console/journald stays text):
#   text  -> [2026-11-04T19:58:13.123Z] [INFO ] message
#   json  -> one JSON object per line, for the OCI Logging agent's JSON parser
# Set json on the Oracle VM; see deploy/oci-logging/README.md.
LOG_FORMAT=text
# File log location, appended (create the folder: run from the project root).
# The OCI agent must be pointed at this same path (host side: /opt/kevbot/logs).
LOG_FILE=logs/kevbot.log
