node_modules
dist
.env
*.log
.DS_Store
data/inactive_users.json
data/whitelisted_users.json
data/blacklisted_users.json
data/purge_results.json
# SQLite database for the death counters. Runtime state, created on first use;
# never commit it (and the -journal/-wal siblings SQLite may create).
data/kevbot.db*

# Set by the shutdown handler when a deploy stops the bot, read and deleted by
# the next startup to decide whether to post the "awake" announcement. Runtime
# state on the data volume, never committed.
data/deploy-pending.json
data/deploy-pending.json.tmp

# Terraform (deploy/tf): state files carry resource identifiers and are
# machine-specific. Never commit them; .terraform.lock.hcl SHOULD be committed.
deploy/tf/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
