# Kevbot — always-on service.
#
# Install:
#   sudo cp deploy/kevbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kevbot
#
# Useful:
#   systemctl status kevbot      # is it up, and for how long
#   journalctl -u kevbot -f      # live output (stderr, incl. the log lines)
#   journalctl -u kevbot --since "1 hour ago" -p err   # errors only
#   sudo systemctl restart kevbot

[Unit]
Description=Kevbot Discord bot
Documentation=https://github.com/Kevin-Bonilla/kevbot
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
# Back off harder if it crash-loops, so a bad token doesn't spin the CPU.
StartLimitIntervalSec=300
StartLimitBurst=5

WorkingDirectory=/opt/kevbot
# The container runs as uid 1000 (`node`) but these host dirs are owned by the
# ubuntu user, so an EACCES on the log file was the first symptom. Own them to
# 1000:1000 before docker starts; without this the bot logs EACCES and exits.
ExecStartPre=/usr/bin/chown -R 1000:1000 /opt/kevbot/data /opt/kevbot/logs
EnvironmentFile=/opt/kevbot/.env
Environment=NODE_ENV=production
# Keep the container's logs in the journal, not just inside the container.
ExecStartPre=-/usr/bin/docker rm -f kevbot
ExecStart=/usr/bin/docker run \
  --name kevbot \
  --restart=no \
  --env-file /opt/kevbot/.env \
  -v /opt/kevbot/data:/app/data \
  -v /opt/kevbot/logs:/app/logs \
  kevbot:latest
ExecStop=/usr/bin/docker stop -t 30 kevbot
ExecStopPost=-/usr/bin/docker rm -f kevbot

# --- Hardening ---
# The container only needs its own data dir and the Docker socket it was
# started with; everything else is read-only or off.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/kevbot

[Install]
WantedBy=multi-user.target
